# APPLICATION
PROJECT_NAME="Enterprise Talent Platform"
# Genere automatiquement si non defini (voir config.py)

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# OAUTH (Google & Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# POSTGRES (PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_USER=etp_user
POSTGRES_PASSWORD=<a_changer>
POSTGRES_DB=etp_db
DATABASE_URL=postgresql+asyncpg://etp_user:<a_changer>@localhost:5432/etp_db

# REDIS 
REDIS_URL=redis://localhost:6379/0

#  MINIO (S3)
MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=<genere dynamiquement>
# MINIO_SECRET_KEY=<genere dynamiquement>
MINIO_BUCKET_NAME=etp-documents
MINIO_BUCKET_CV=candidats-cv

# IA — clés lues depuis l'environnement, jamais stockées en base
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
AI_REQUEST_TIMEOUT=30
AI_MAX_CV_CHARS=12000

# FRONTEND (liens de confirmation email)
FRONTEND_URL=http://localhost:3000

# SMTP — dev : MailHog/Mailpit sur le port 1025 (TLS desactive)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@etp-platform.com
SMTP_TLS=false
SMTP_SSL=false
SMTP_TIMEOUT=15
EMAIL_VERIFICATION_EXPIRE_HOURS=24
