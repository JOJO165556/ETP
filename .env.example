# APPLICATION
PROJECT_NAME="Enterprise Talent Platform"
# IMPORTANT : clé de signature JWT — définissez une valeur FIXE et secrète,
# sinon un secret aléatoire est généré à chaque démarrage et tous les tokens expirent (restart = déconnexion du monde).
SECRET_KEY=changer-moi-avec-des-64-caracteres-aleatoires-securises-xxxxxxxxxxxxxxxx

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# AUTHENTIFICATION - Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
# Peut aussi pointer vers un fichier JSON du service account :
# GOOGLE_APPLICATION_CREDENTIALS=./.firebase-service-account.json
FIREBASE_APP_CHECK_ENABLED=false

# POSTGRES (PostGIS) : nom de service Docker cote conteneurs
POSTGRES_SERVER=db
POSTGRES_USER=etp_user
POSTGRES_PASSWORD=<a_changer>
POSTGRES_DB=etp_db
DATABASE_URL=postgresql+asyncpg://etp_user:<a_changer>@localhost:5432/etp_db

# REDIS 
REDIS_URL=redis://redis:6379/0

#  MINIO (S3)
MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=<genere dynamiquement>
# MINIO_SECRET_KEY=<genere dynamiquement>
MINIO_BUCKET_NAME=etp-documents
MINIO_BUCKET_CV=candidats-cv

# IA — clés lues depuis l'environnement, jamais stockées en base
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
AI_REQUEST_TIMEOUT=30
AI_MAX_CV_CHARS=12000

# FRONTEND (liens de confirmation email)
FRONTEND_URL=http://localhost:3000

# SMTP — dev : MailHog/Mailpit sur le port 1025 (TLS desactive)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@etp-platform.com
SMTP_TLS=false
SMTP_SSL=false
SMTP_TIMEOUT=15
EMAIL_VERIFICATION_EXPIRE_HOURS=24
