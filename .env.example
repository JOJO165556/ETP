# APPLICATION
PROJECT_NAME="Enterprise Talent Platform"
# Clé JWT : fixe et secrète (64+ chars). Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changer-moi-avec-des-64-caracteres-aleatoires-securises-xxxxxxxxxxxxxxxx
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# CORS — liste JSON ou virgule-séparée
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# FRONTEND
FRONTEND_URL=http://localhost:3000

# POSTGRES — format Neon accepté : postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql+asyncpg://etp_user:<a_changer>@localhost:5432/etp_db
POSTGRES_SERVER=localhost
POSTGRES_USER=etp_user
POSTGRES_PASSWORD=<a_changer>
POSTGRES_DB=etp_db

# REDIS — format Upstash : rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# STOCKAGE S3 — MinIO en dev, Cloudflare R2 en prod
# Endpoint R2 : https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=etp-documents
S3_BUCKET_CV=candidats-cv
S3_REGION=auto
S3_USE_SSL=false
# URL publique du bucket (R2 public ou CDN), laisser vide pour presigned URLs
S3_PUBLIC_URL=

# Aliases legacy MinIO (compatibilité modules existants)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=etp-documents
MINIO_BUCKET_CV=candidats-cv

# EMAIL — Resend en prod : smtp.resend.com:465, user=resend, pass=re_xxx
# Dev : Mailpit sur port 1025, sans auth
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@etp-platform.com
SMTP_TLS=false
SMTP_SSL=false
SMTP_TIMEOUT=15
RESEND_API_KEY=
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# FIREBASE — https://console.firebase.google.com → Paramètres → Comptes de service
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_APP_CHECK_ENABLED=false

# INTELLIGENCE ARTIFICIELLE
# Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hugging Face (fallback) : https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
AI_REQUEST_TIMEOUT=30
AI_MAX_CV_CHARS=12000
